    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="meta" targetRef="save" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="general" targetRef="save" />
    <bpmn:sequenceFlow id="Flow_7" name="Да" sourceRef="dynamic" targetRef="settings" />
    <bpmn:sequenceFlow id="Flow_8" name="Нет" sourceRef="dynamic" targetRef="unavailable" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="settings" targetRef="save" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="save" targetRef="apply" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="apply" targetRef="again" />
    <bpmn:sequenceFlow id="Flow_12" name="Да" sourceRef="again" targetRef="kind" />
    <bpmn:sequenceFlow id="Flow_13" name="Нет" sourceRef="again" targetRef="end" />
  </bpmn:process>
