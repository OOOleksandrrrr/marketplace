        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="855" y="415" width="54" height="54" />
        <bpmndi:BPMNLabel>
          <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="833" y="475" width="98" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_Decompose" bpmnElement="N_Decompose">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="1050" y="405" width="188" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_Rules" bpmnElement="N_Rules">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="1285" y="405" width="188" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_Plan" bpmnElement="N_Plan">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="1520" y="405" width="188" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_Cancel" bpmnElement="N_Cancel">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="1955" y="190" width="38" height="38" />
        <bpmndi:BPMNLabel>
          <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="1924" y="234" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_Register" bpmnElement="N_Register">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="1990" y="405" width="188" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_Split" bpmnElement="N_Split" isMarkerVisible="true">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2230" y="415" width="54" height="54" />
        <bpmndi:BPMNLabel>
          <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2196" y="391" width="122" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_AcceptA" bpmnElement="N_AcceptA">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2410" y="655" width="178" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_DoA" bpmnElement="N_DoA">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2650" y="655" width="178" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_SendA" bpmnElement="N_SendA">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2890" y="655" width="178" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_AcceptB" bpmnElement="N_AcceptB">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2410" y="905" width="178" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_DoB" bpmnElement="N_DoB">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2650" y="905" width="178" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_SendB" bpmnElement="N_SendB">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="2890" y="905" width="178" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_N_Check" bpmnElement="N_Check">
        <dc:Bounds xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" x="3690" y="405" width="188" height="76" />
