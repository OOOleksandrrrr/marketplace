<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_PartialFailure" targetNamespace="https://example.org/gias-rkd/order-orchestration" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="Process_PartialFailure" name="Частичный сбой одного из поставщиков" isExecutable="false">
    <bpmn:documentation>Аналитическая модель макета по п. 3.2.2.3 ТЗ. Успешный результат поставщика A сохраняется. Показаны формализованные варианты коррекции: повтор, замена поставщика и принятие частичного результата. Внутренняя работа поставщиков не моделируется.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PartialFailure">
      <bpmn:lane id="Lane_PartialFailure_supplier_b" name="Поставщик B / замещающий поставщик">
        <bpmn:flowNodeRef>F_DoReplacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_SendReplacementResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_DoB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PartialFailure_supplier_a" name="Поставщик A">
        <bpmn:flowNodeRef>F_DoA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_SendA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PartialFailure_system" name="Система-агрегатор">
        <bpmn:flowNodeRef>F_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_CheckB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_RecordFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_SaveA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_CountFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_AggregateFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_SendReplacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Partial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_ResultB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_TimeoutB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_ErrorB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_WaitB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_MergeFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Full</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_CountRecovered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Recovered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_CheckReplacement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_CountPartial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_PackagePartial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_AggregateRecovered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PartialFailure_customer" name="Пользователь">
        <bpmn:flowNodeRef>F_DecidePartial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_UserFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_UserRecovered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_EndFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_EndFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_AcceptPartial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_EndRecovered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_EndPartial</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="F_Start" name="Заказ подтверждён">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:outgoing>FF01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="F_Register" name="Создать заказ, два подзаказа&#10;и плановые объёмы">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF01</bpmn:incoming>
      <bpmn:outgoing>FF02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="F_Split" name="Запустить параллельно">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF02</bpmn:incoming>
      <bpmn:outgoing>FF03</bpmn:outgoing>
      <bpmn:outgoing>FF07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="F_DoA" name="Исполнить подзаказ A">
      <bpmn:documentation>Внешнее действие поставщика без раскрытия его внутреннего процесса.</bpmn:documentation>
      <bpmn:incoming>FF03</bpmn:incoming>
      <bpmn:outgoing>FF04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="F_SendA" name="Передать результат A&#10;и фактический объём">
      <bpmn:documentation>Внешнее действие поставщика без раскрытия его внутреннего процесса.</bpmn:documentation>
      <bpmn:incoming>FF04</bpmn:incoming>
      <bpmn:outgoing>FF05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="F_SaveA" name="Проверить и сохранить A;&#10;учесть принятый объём">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF05</bpmn:incoming>
      <bpmn:outgoing>FF06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="F_DoB" name="Исполнять подзаказ B">
      <bpmn:documentation>Внешнее действие поставщика без раскрытия его внутреннего процесса.</bpmn:documentation>
      <bpmn:incoming>FF07</bpmn:incoming>
      <bpmn:incoming>FF27</bpmn:incoming>
      <bpmn:outgoing>FF08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="F_WaitB" name="Событие по B">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF08</bpmn:incoming>
      <bpmn:outgoing>FF09</bpmn:outgoing>
      <bpmn:outgoing>FF10</bpmn:outgoing>
      <bpmn:outgoing>FF11</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="F_ResultB" name="Результат B получен">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF09</bpmn:incoming>
      <bpmn:outgoing>FF12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_F_ResultB" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="F_ErrorB" name="Сообщение об ошибке">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF10</bpmn:incoming>
      <bpmn:outgoing>FF14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_F_ErrorB" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="F_TimeoutB" name="Истёк срок ожидания">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF11</bpmn:incoming>
      <bpmn:outgoing>FF15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_F_TimeoutB">
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="F_CheckB" name="Проверить результат B">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF12</bpmn:incoming>
      <bpmn:outgoing>FF13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F_MergeFail" name="Сбой подтверждён">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF14</bpmn:incoming>
      <bpmn:incoming>FF15</bpmn:incoming>
      <bpmn:outgoing>FF16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F_RecordFail" name="Зафиксировать причину,&#10;неисполненный объём и SLA">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF16</bpmn:incoming>
      <bpmn:outgoing>FF17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="F_Join" name="Завершить обе ветви">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF06</bpmn:incoming>
      <bpmn:incoming>FF13</bpmn:incoming>
      <bpmn:incoming>FF17</bpmn:incoming>
      <bpmn:outgoing>FF18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="F_Full" name="Все позиции исполнены?">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF18</bpmn:incoming>
      <bpmn:outgoing>FF19</bpmn:outgoing>
      <bpmn:outgoing>FF23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F_CountFull" name="Зафиксировать итоговые&#10;объёмы без двойного учёта">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF19</bpmn:incoming>
      <bpmn:outgoing>FF20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F_AggregateFull" name="Агрегировать результаты&#10;и итоговый отчёт">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF20</bpmn:incoming>
      <bpmn:outgoing>FF21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="F_UserFull" name="Получить полный комплект">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF21</bpmn:incoming>
      <bpmn:outgoing>FF22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="F_EndFull" name="Заказ исполнен">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="F_Partial" name="Присвоить состояние&#10;«Частичный сбой»">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF23</bpmn:incoming>
      <bpmn:outgoing>FF24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F_Rules" name="Применить правила коррекции,&#10;приоритетов и ограничений">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF24</bpmn:incoming>
      <bpmn:outgoing>FF25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F_Action" name="Корректирующее действие">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF25</bpmn:incoming>
      <bpmn:outgoing>FF26</bpmn:outgoing>
      <bpmn:outgoing>FF28</bpmn:outgoing>
      <bpmn:outgoing>FF29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F_Retry" name="Создать новую попытку B;&#10;сохранить связь и номер">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF26</bpmn:incoming>
      <bpmn:outgoing>FF27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F_Select" name="Подобрать замещающего&#10;поставщика и предложение">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF28</bpmn:incoming>
      <bpmn:outgoing>FF30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F_Changed" name="Изменились цена, срок&#10;или характеристики?">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF30</bpmn:incoming>
      <bpmn:outgoing>FF31</bpmn:outgoing>
      <bpmn:outgoing>FF35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="F_Approve" name="Подтвердить изменённые&#10;условия замены">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF31</bpmn:incoming>
      <bpmn:outgoing>FF32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="F_Agree" name="Изменения приняты?">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF32</bpmn:incoming>
      <bpmn:outgoing>FF33</bpmn:outgoing>
      <bpmn:outgoing>FF34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F_SendReplacement" name="Направить подзаказ B2&#10;замещающему поставщику">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF33</bpmn:incoming>
      <bpmn:incoming>FF35</bpmn:incoming>
      <bpmn:outgoing>FF36</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="F_DoReplacement" name="Исполнить замещающий&#10;подзаказ B2">
      <bpmn:documentation>Внешнее действие поставщика без раскрытия его внутреннего процесса.</bpmn:documentation>
      <bpmn:incoming>FF36</bpmn:incoming>
      <bpmn:outgoing>FF37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="F_SendReplacementResult" name="Передать результат B2&#10;и фактический объём">
      <bpmn:documentation>Внешнее действие поставщика без раскрытия его внутреннего процесса.</bpmn:documentation>
      <bpmn:incoming>FF37</bpmn:incoming>
      <bpmn:outgoing>FF38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="F_CheckReplacement" name="Проверить B2 и закрыть&#10;неисполненный объём B">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF38</bpmn:incoming>
      <bpmn:outgoing>FF39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="F_Recovered" name="Полнота восстановлена?">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF39</bpmn:incoming>
      <bpmn:outgoing>FF40</bpmn:outgoing>
      <bpmn:outgoing>FF44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F_CountRecovered" name="Пересчитать итог: A + B2;&#10;исключить двойной учёт">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF40</bpmn:incoming>
      <bpmn:outgoing>FF41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F_AggregateRecovered" name="Агрегировать сохранённый A,&#10;B2, метаданные и отчёт">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF41</bpmn:incoming>
      <bpmn:outgoing>FF42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="F_UserRecovered" name="Получить комплект&#10;после замены">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF42</bpmn:incoming>
      <bpmn:outgoing>FF43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="F_EndRecovered" name="Исполнен после коррекции">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF43</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="F_DecidePartial" name="Решить: принять доступный&#10;результат A или отказаться">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF29</bpmn:incoming>
      <bpmn:incoming>FF34</bpmn:incoming>
      <bpmn:incoming>FF44</bpmn:incoming>
      <bpmn:outgoing>FF45</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="F_AcceptPartial" name="Принять частичный&#10;результат?">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF45</bpmn:incoming>
      <bpmn:outgoing>FF46</bpmn:outgoing>
      <bpmn:outgoing>FF49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="F_CountPartial" name="Учесть исполненный A и&#10;неисполненный остаток B">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF46</bpmn:incoming>
      <bpmn:outgoing>FF47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="F_PackagePartial" name="Сформировать доступный&#10;комплект и отчёт о сбое">
      <bpmn:documentation>Функция проектируемой системы-агрегатора.</bpmn:documentation>
      <bpmn:incoming>FF47</bpmn:incoming>
      <bpmn:outgoing>FF48</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="F_EndPartial" name="Частично исполнен">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF48</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="F_EndFailed" name="Не исполнен">
      <bpmn:documentation>Пользовательское действие.</bpmn:documentation>
      <bpmn:incoming>FF49</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FF01" sourceRef="F_Start" targetRef="F_Register" />
    <bpmn:sequenceFlow id="FF02" sourceRef="F_Register" targetRef="F_Split" />
    <bpmn:sequenceFlow id="FF03" sourceRef="F_Split" targetRef="F_DoA" />
    <bpmn:sequenceFlow id="FF04" sourceRef="F_DoA" targetRef="F_SendA" />
    <bpmn:sequenceFlow id="FF05" sourceRef="F_SendA" targetRef="F_SaveA" />
    <bpmn:sequenceFlow id="FF06" sourceRef="F_SaveA" targetRef="F_Join" />
    <bpmn:sequenceFlow id="FF07" sourceRef="F_Split" targetRef="F_DoB" />
    <bpmn:sequenceFlow id="FF08" sourceRef="F_DoB" targetRef="F_WaitB" />
    <bpmn:sequenceFlow id="FF09" name="Результат" sourceRef="F_WaitB" targetRef="F_ResultB" />
    <bpmn:sequenceFlow id="FF10" name="Ошибка" sourceRef="F_WaitB" targetRef="F_ErrorB" />
    <bpmn:sequenceFlow id="FF11" name="Тайм-аут" sourceRef="F_WaitB" targetRef="F_TimeoutB" />
    <bpmn:sequenceFlow id="FF12" sourceRef="F_ResultB" targetRef="F_CheckB" />
    <bpmn:sequenceFlow id="FF13" sourceRef="F_CheckB" targetRef="F_Join" />
    <bpmn:sequenceFlow id="FF14" sourceRef="F_ErrorB" targetRef="F_MergeFail" />
    <bpmn:sequenceFlow id="FF15" sourceRef="F_TimeoutB" targetRef="F_MergeFail" />
    <bpmn:sequenceFlow id="FF16" sourceRef="F_MergeFail" targetRef="F_RecordFail" />
    <bpmn:sequenceFlow id="FF17" sourceRef="F_RecordFail" targetRef="F_Join" />
