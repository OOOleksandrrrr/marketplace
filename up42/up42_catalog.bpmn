<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UP42" targetNamespace="http://example.com/up42" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="Process_UP42_Catalog" name="UP42 — Покупка архивных данных" isExecutable="false">
    <bpmn:extensionElements />
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Platform" name="Платформа UP42">
        <bpmn:flowNodeRef>Task_ProcessAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculatePrice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccessGranted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FulfillOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Balance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Access</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customer" name="Заказчик">
        <bpmn:flowNodeRef>Task_ChooseCollection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptEULA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangeSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseScene</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Потребность в данных">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ChooseCollection" name="Выбрать коллекцию">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Access" name="Есть доступ?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RequestAccess" name="Запросить доступ">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProcessAccess" name="Обработать запрос доступа">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AccessGranted" name="Доступ предоставлен?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_NoAccess" name="Покупка недоступна">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_AcceptEULA" name="Ознакомиться с EULA и принять условия (при необходимости)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SetSearch" name="Задать AOI и фильтры поиска">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Search" name="Найти подходящие сцены">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Found" name="Сцены найдены?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ChangeSearch" name="Изменить параметры поиска">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ChooseScene" name="Выбрать сцены и добавить продукты в корзину">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CalculatePrice" name="Рассчитать стоимость заказа">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Balance" name="Достаточно средств?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdjustOrder" name="Пополнить баланс или изменить заказ">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmOrder" name="Проверить и подтвердить заказ">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateOrder" name="Создать заказ">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Task_FulfillOrder" name="Организовать выполнение заказа">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:startEvent id="SubStart">
        <bpmn:outgoing>SubFlow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SubTask" name="Получить и подготовить ресурсы">
        <bpmn:incoming>SubFlow_1</bpmn:incoming>
        <bpmn:outgoing>SubFlow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SubEnd">
        <bpmn:incoming>SubFlow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SubFlow_1" sourceRef="SubStart" targetRef="SubTask" />
      <bpmn:sequenceFlow id="SubFlow_2" sourceRef="SubTask" targetRef="SubEnd" />
    </bpmn:subProcess>
    <bpmn:task id="Task_Deliver" name="Предоставить ресурсы в хранилище">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Download" name="Скачать доступные ресурсы">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Success" name="Данные получены">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ChooseCollection" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ChooseCollection" targetRef="Gateway_Access" />
    <bpmn:sequenceFlow id="Flow_3" name="Да" sourceRef="Gateway_Access" targetRef="Task_AcceptEULA" />
    <bpmn:sequenceFlow id="Flow_4" name="Нет" sourceRef="Gateway_Access" targetRef="Task_RequestAccess" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RequestAccess" targetRef="Task_ProcessAccess" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ProcessAccess" targetRef="Gateway_AccessGranted" />
    <bpmn:sequenceFlow id="Flow_7" name="Да" sourceRef="Gateway_AccessGranted" targetRef="Task_AcceptEULA" />
    <bpmn:sequenceFlow id="Flow_8" name="Нет" sourceRef="Gateway_AccessGranted" targetRef="EndEvent_NoAccess" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AcceptEULA" targetRef="Task_SetSearch" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SetSearch" targetRef="Task_Search" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Search" targetRef="Gateway_Found" />
    <bpmn:sequenceFlow id="Flow_12" name="Нет" sourceRef="Gateway_Found" targetRef="Task_ChangeSearch" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ChangeSearch" targetRef="Task_SetSearch" />
    <bpmn:sequenceFlow id="Flow_14" name="Да" sourceRef="Gateway_Found" targetRef="Task_ChooseScene" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ChooseScene" targetRef="Task_CalculatePrice" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CalculatePrice" targetRef="Gateway_Balance" />
    <bpmn:sequenceFlow id="Flow_17" name="Да" sourceRef="Gateway_Balance" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_18" name="Нет" sourceRef="Gateway_Balance" targetRef="Task_AdjustOrder" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_AdjustOrder" targetRef="Task_CalculatePrice" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ConfirmOrder" targetRef="Task_CreateOrder" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CreateOrder" targetRef="Task_FulfillOrder" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_FulfillOrder" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Deliver" targetRef="Task_Download" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Download" targetRef="EndEvent_Success" />
  </bpmn:process>
